# Environment reference only: Orin does not load .env files.
# Set these variables in the shell/environment that launches Orin.
ORIN_LOG=orin=info,warn

# Optional Gemini sign-in detection. Leave empty unless configured by you.
# Orin checks presence only and does not store the values in workspace settings.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Test harness only (never needed for normal use):
# ORIN_TEST_AGENT=absolute/path/to/orin-acp-fixture
# ORIN_LIVE_AGENT=gemini
# ORIN_UPDATE_BASELINES=1

# Updater overrides, honoured only by debug builds (release builds ignore them):
# ORIN_RELEASE_TARGET=windows-x86_64          # pretend to be this release build (release builds set it at compile time)
# ORIN_UPDATE_SOURCES=http://127.0.0.1:8080/github|http://127.0.0.1:8080/gitlab
# ORIN_UPDATE_DIR=absolute/path/for/update/downloads
